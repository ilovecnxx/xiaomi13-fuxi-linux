+/* The modem allocates its own GSI channels on fuxi, and they must be
+ * halted once the modem is offline so it can allocate them again on
+ * its next boot.
+ */
+static void ipa_modem_offline(struct ipa *ipa)
+{
+	struct device *dev = ipa->dev;
+	int ret;
+
+	ret = pm_runtime_get_sync(dev);
+	if (ret < 0) {
+		dev_err(dev, "error %d getting power to halt modem channels\n",
+			ret);
+		goto out_power_put;
+	}
+
+	ipa_endpoint_modem_halt_all(ipa);
+	dev_info(dev, "fuxi: halted modem GSI channels\n");
+
+out_power_put:
+	(void)pm_runtime_put_autosuspend(dev);
+}
