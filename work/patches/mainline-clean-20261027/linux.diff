diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 292392ded..0f5cacb89 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -460,6 +460,14 @@ config AMPERE_ERRATUM_AC04_CPU_23
 config ARM64_WORKAROUND_CLEAN_CACHE
 	bool
 
+config FUXI_FORCE_BUILTIN_DTB
+	bool "fuxi: force use of built-in board DTB"
+	default n
+	help
+	  Xiaomi 13 (fuxi) 的 ABL 只能处理厂商 DTB（它会叠加 dtbo 分区的 overlay）。
+	  打开后内核在 setup_arch 里忽略 ABL 传入的 DTB，改用编进内核的
+	  sm8550-xiaomi-fuxi-min.dtb（arch/arm64/kernel/fuxi_dtb.S）。
+
 config ARM64_ERRATUM_826319
 	bool "Cortex-A53: 826319: System might deadlock if a write cannot complete until read data is accepted"
 	default y
diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 88230c4e0..c42eceb1a 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -437,6 +437,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-hdk-display-card.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-hdk-rear-camera-card.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-hdk.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-mtp.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-xiaomi-fuxi-min.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-qrd.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-samsung-q5q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-sony-xperia-yodo-pdx234.dtb
diff --git a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
index fc5d1a0c3..9be5c8007 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -90,3 +90,8 @@ endif
 
 # for cleaning
 subdir- += vdso vdso32
+
+# fuxi（Xiaomi 13）：内建主线板级 DTB + simpledrm 之前的早期屏幕 console
+obj-$(CONFIG_FUXI_FORCE_BUILTIN_DTB)	+= fuxi_dtb.o fuxi_early.o
+# DTB 改了要重新嵌入
+$(obj)/fuxi_dtb.o: arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-min.dtb
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index a707deba6..2cd71fe09 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -289,6 +289,16 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	early_fixmap_init();
 	early_ioremap_init();
 
+	/*
+	 * fuxi: ABL 会把 dtbo 分区的厂商 overlay 叠到 boot 镜像附带的 DTB 上，叠到主线
+	 * DTB 会卡死，所以 boot 镜像附带厂商 DTB，内核在这里改用编进来的主线 DTB。
+	 */
+#if IS_ENABLED(CONFIG_FUXI_FORCE_BUILTIN_DTB)
+	{
+		extern const unsigned char fuxi_dtb[];
+		__fdt_pointer = __pa_symbol((unsigned long)fuxi_dtb);
+	}
+#endif
 	setup_machine_fdt(__fdt_pointer);
 
 	/*
