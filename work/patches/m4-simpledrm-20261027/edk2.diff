+// [TRIM]   INF FatPkg/EnhancedFatDxe/Fat.inf
+// [TRIM]   INF MdeModulePkg/Universal/Disk/UnicodeCollation/EnglishDxe/EnglishDxe.inf
+// [TRIM]   INF MdeModulePkg/Universal/FvSimpleFileSystemDxe/FvSimpleFileSystemDxe.inf
