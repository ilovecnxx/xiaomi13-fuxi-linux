+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					    qcom_battmgr_prop_to_fw(battmgr, prop), 0);
 	mutex_unlock(&battmgr->lock);
 
 	return ret;
@@ -1381,7 +1405,8 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 
 	switch (opcode) {
 	case BATTMGR_BAT_PROPERTY_GET:
-		property = le32_to_cpu(resp->intval.property);
+		property = qcom_battmgr_prop_from_fw(battmgr,
+						     le32_to_cpu(resp->intval.property));
 		if (property == BATT_MODEL_NAME) {
 			if (payload_len != sizeof(resp->strval)) {
 				dev_warn(battmgr->dev,
@@ -1658,6 +1683,12 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	else
 		battmgr->variant = QCOM_BATTMGR_SM8350;
 
+	/* Xiaomi firmware: shifted property ids and no charge control thresholds */
+	if (of_machine_is_compatible("xiaomi,fuxi")) {
+		battmgr->shifted_props = true;
+		battmgr->variant = QCOM_BATTMGR_SM8350;
+	}
+
 	ret = qcom_battmgr_charge_control_thresholds_init(battmgr);
 	if (ret < 0)
 		return dev_err_probe(dev, ret,
diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index 954be9343..ee0eadd5b 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -3040,9 +3040,26 @@ static const struct dev_pm_ops ufs_qcom_pm_ops = {
 #endif
 };
 
+/*
+ * ufshcd_wl_shutdown() powers the UFS device off and ufs_qcom_suspend() then
+ * leaves the device reset line asserted. The TLMM UFS_RESET setting is not
+ * restored to its power-on value by a warm reset, so the boot ROM would find
+ * the device still held in reset and fall into EDL (seen on SM8550). Release
+ * it, as the downstream driver does.
+ */
+static void ufs_qcom_shutdown(struct platform_device *pdev)
+{
+	struct ufs_hba *hba = platform_get_drvdata(pdev);
+	struct ufs_qcom_host *host = hba ? ufshcd_get_variant(hba) : NULL;
+
+	if (host && host->device_reset)
+		ufs_qcom_device_reset_ctrl(hba, false);
+}
+
 static struct platform_driver ufs_qcom_pltform = {
 	.probe	= ufs_qcom_probe,
 	.remove = ufs_qcom_remove,
+	.shutdown = ufs_qcom_shutdown,
 	.driver	= {
 		.name	= "ufshcd-qcom",
 		.pm	= &ufs_qcom_pm_ops,
