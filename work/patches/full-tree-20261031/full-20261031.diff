+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 13: no *_ignore_unused at all; unclaimed clocks are gated once
+ * their providers reach sync_state, as on upstream SM8550 boards.  QCE/ICE
+ * and the GMU never bind a driver, so sync_state is forced after the
+ * deferred probe timeout instead of keeping interconnect votes at max.
+ * Without modules the late_initcall pass skips suppliers still parked on
+ * the paused deferred_sync list, so deferred_probe_timeout=30 re-runs it
+ * after the firmware-dependent devices (ath12k, sound card) have probed.
+ */
+
+#include "sm8550-xiaomi-fuxi-r120idle-mic-rupd-audio-disp.dts"
+
+/ {
+	chosen {
+		bootargs = "loglevel=7 log_buf_len=2M panic=0 arm-smmu.disable_bypass=0 fbcon=font:TER16x32 console=tty0 fuxi.fb=0xB8000000,1080,2400,1080,32 rdinit=/init g_cdc.idVendor=0x0525 g_cdc.idProduct=0xa4a7 g_cdc.dev_addr=02:f0:c5:13:00:02 g_cdc.host_addr=02:f0:c5:13:00:01 panel_xiaomi_fuxi.refresh=120 fw_devlink.sync_state=timeout deferred_probe_timeout=30";
+	};
+};
