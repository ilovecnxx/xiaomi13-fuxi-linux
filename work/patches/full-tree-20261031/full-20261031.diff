+/* The Xiaomi 13 (fuxi) modem firmware allocates SMEM_IPA_FILTER_TABLE
+ * itself, and asserts if the AP has already allocated it.  The IPA still
+ * reaches that item through the AP's SMMU context, at the physical address
+ * the modem chose.  So map the whole SMEM region one-to-one rather than a
+ * single item allocated here.
+ */
+static int ipa_smem_map_region(struct ipa *ipa)
+{
+	struct device *dev = ipa->dev;
+	struct iommu_domain *domain;
+	struct device_node *np;
+	struct resource res;
+	phys_addr_t phys;
+	size_t size;
+	int ret;
+
+	np = of_find_compatible_node(NULL, NULL, "qcom,smem");
+	if (!np) {
+		dev_err(dev, "no SMEM node found\n");
+		return -ENODEV;
+	}
+
+	ret = of_address_to_resource(np, 0, &res);
+	of_node_put(np);
+	if (ret) {
+		dev_err(dev, "error %d getting SMEM region\n", ret);
+		return ret;
+	}
+
+	domain = iommu_get_domain_for_dev(dev);
+	if (!domain) {
+		dev_err(dev, "no IOMMU domain found for SMEM\n");
+		return -EINVAL;
+	}
+
+	phys = res.start & PAGE_MASK;
+	size = PAGE_ALIGN(resource_size(&res) + res.start - phys);
+
+	ret = iommu_map(domain, phys, phys, size, IOMMU_READ | IOMMU_WRITE,
+			GFP_KERNEL);
+	if (ret) {
+		dev_err(dev, "error %d mapping SMEM region\n", ret);
+		return ret;
+	}
+
+	ipa->smem_iova = phys;
+	ipa->smem_size = size;
+	ipa->smem_modem_owned = true;
+
+	dev_info(dev, "fuxi: mapped SMEM %pa size %#zx, item %u left to modem\n",
+		 &phys, size, SMEM_IPA_FILTER_TABLE);
+
+	return 0;
+}
