+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01, 0x64, 0x92);
+	xiaomi_fuxi_dcs_long_write_seq_multi(&dsi_ctx, 0x92, 0x70);
