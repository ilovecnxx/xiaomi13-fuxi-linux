diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-modem.dtsi b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-modem.dtsi
new file mode 100644
index 000000000..529cce27a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-modem.dtsi
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 13 (fuxi)：基带变体。在 sm8550-xiaomi-fuxi-min.dts 的基础上打开 IPA 与 MPSS（基带 Q6）。
+ * 固件取自手机自己的 modem 分区 image/（只读复制），放 /lib/firmware/qcom/sm8550/xiaomi/fuxi/。
+ *
+ * 两者都在根文件系统挂好后才启动（initramfs 里没有固件）：
+ *   - IPA 在 initramfs 阶段 probe 失败（找不到 ipa_fws），由 fuxi-firmware-devices 再 bind 一次；
+ *   - MPSS 由 rmtfs（-s，文件模式，只写 EFS 副本）在自己就绪后启动，fuxi-firmware-devices 不碰它。
+ * 保留内存（mpss/q6_mpss_dtb/mpss_dsm/ipa_fw/ipa_gsi/rmtfs）与运行中 DTB 一致，沿用 sm8550.dtsi。
+ *
+ * 构建：FUXI_DTB=sm8550-xiaomi-fuxi-modem scripts/fuxi-build-abl.sh <名字>
+ */
+
+
+/*
+ * 厂商 DTB 的 ipa_smmu_ap（SID 0x4a0）用 qcom,additional-mapping 直通映射 IMEM 0x146a8000/0x2000，
+ * sm8550.dtsi 的 modem-tables@8000 对应 0x14688000。modem11 实测 IPA 访问 iova 0x146a9080 触发
+ * SMMU context fault（SID 0x4a0），随后基带报 IPA_IRQ_STTS 0x1（BAD_SNOC_ACCESS）。按厂商地址映射。
+ */
+&{/soc@0/sram@14680000} {
+	ipa_modem_tables_fuxi: modem-tables@28000 {
+		reg = <0x28000 0x2000>;
+	};
+};
+
+&ipa {
+	firmware-name = "qcom/sm8550/xiaomi/fuxi/ipa_fws.mdt";
+	sram = <&ipa_modem_tables_fuxi>;
+	status = "okay";
+};
+
+&remoteproc_mpss {
+	firmware-name = "qcom/sm8550/xiaomi/fuxi/modem.mdt",
+			"qcom/sm8550/xiaomi/fuxi/modem_dtb.mdt";
+	status = "okay";
+};
