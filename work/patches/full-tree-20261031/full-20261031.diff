+// SPDX-License-Identifier: BSD-3-Clause
+/* Xiaomi 13 (fuxi)：audio 变体（内容见 sm8550-xiaomi-fuxi-audio.dtsi） */
+
+#include "sm8550-xiaomi-fuxi-min.dts"
