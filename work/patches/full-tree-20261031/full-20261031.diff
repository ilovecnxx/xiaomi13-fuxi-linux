+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 13 (fuxi)：桌面变体 = 原生显示（-disp：面板 + GPU）+ 完整 USB-C + DisplayPort alt mode（USB-C 接显示器/扩展坞）。
+ * 构建：FUXI_DTB=sm8550-xiaomi-fuxi-desk scripts/fuxi-build-abl.sh <名字>
+ */
+
+#include "sm8550-xiaomi-fuxi-min.dts"
+#include "sm8550-xiaomi-fuxi-disp.dtsi"
+#include "sm8550-xiaomi-fuxi-usbc.dtsi"
+
+&mdss_dp0 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-disp.dts b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-disp.dts
new file mode 100644
index 000000000..6dc2ac84e
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-disp.dts
@@ -0,0 +1,5 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Xiaomi 13 (fuxi)：disp 变体（内容见 sm8550-xiaomi-fuxi-disp.dtsi） */
+
+#include "sm8550-xiaomi-fuxi-min.dts"
+#include "sm8550-xiaomi-fuxi-disp.dtsi"
diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-disp.dtsi b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-disp.dtsi
new file mode 100644
index 000000000..72a5f658a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-disp.dtsi
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 13 (fuxi)：原生显示驱动变体。在 sm8550-xiaomi-fuxi-min.dts 的基础上，把 simpledrm +
+ * MDSS 占位换成真正的 MSM 显示通路（dispcc + MDSS/DPU + DSI0 + 7nm DSI PHY + 面板驱动
+ * panel-xiaomi-fuxi）。面板参数取自厂商 DTB qcom,mdss_dsi_m3_38_0c_0a_dsc_cmd（见
+ * work/device-info/panel-m3-38-0c-0a.dtsi）。
+ *
+ * 构建：FUXI_DTB=sm8550-xiaomi-fuxi-disp scripts/fuxi-build-abl.sh <名字>
+ */
+
+
+/ {
+	/* 面板三路电源都是 GPIO 控制的负载开关（厂商 display_panel_vddio/vci/vddd），开机时已打开 */
+	panel_vddio_1p8: regulator-panel-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddio_1p8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 126 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	panel_vci_3p0: regulator-panel-vci {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vci_3p0";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		gpio = <&tlmm 127 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	panel_vddd_1p5: regulator-panel-vddd {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddd_1p5";
+		regulator-min-microvolt = <1500000>;
+		regulator-max-microvolt = <1500000>;
+		gpio = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+};
+
+&dispcc {
+	status = "okay";
+};
+
+/*
+ * 原生显示变体只让 MSM DPU/DSI 作为 DRM 输出。保留启动 framebuffer 的保留内存与
+ * fuxi 早期 console，但不注册第二张 simpledrm 卡，避免桌面选中旧 bootloader 输出。
+ */
+&framebuffer0 {
+	status = "disabled";
+};
+
+/* -min 里为了当 sync_state 占位删掉了 iommus；真驱动要用 SMMU */
+&mdss {
+	iommus = <&apps_smmu 0x1c00 0x2>;
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l3e_1p2>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "xiaomi,fuxi-m3-38-0c-0a";
+		reg = <0>;
+
+		pinctrl-0 = <&sde_dsi_active>, <&sde_te>;
+		pinctrl-1 = <&sde_dsi_suspend>, <&sde_te>;
+		pinctrl-names = "default", "sleep";
+
+		reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;
+
+		vddio-supply = <&panel_vddio_1p8>;
+		vddd-supply = <&panel_vddd_1p5>;
+		vci-supply = <&panel_vci_3p0>;
+
+		port {
+			panel0_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel0_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l1e_0p88>;
+	status = "okay";
+};
+
+&tlmm {
+	sde_dsi_active: sde-dsi-active-state {
+		pins = "gpio133";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	sde_dsi_suspend: sde-dsi-suspend-state {
+		pins = "gpio133";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	/* 厂商 sde_te_active：GPIO86 mdp_vsync */
+	sde_te: sde-te-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+/*
+ * GPU：Adreno 740。a740_sqe.fw、gmu_gen70200.bin 放 /lib/firmware/qcom/；签名的 zap shader 取自 Android
+ * /vendor/firmware（a740_zap.mdt + .bNN），放 /lib/firmware/qcom/sm8550/xiaomi/fuxi/。
+ * 固件在第一次打开 GPU 时才加载（那时根文件系统已挂好）。
+ */
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8550/xiaomi/fuxi/a740_zap.mdt";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-full.dts b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-full.dts
new file mode 100644
index 000000000..b769d033c
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-full.dts
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 13 (fuxi)：完整镜像 = 主 DTS + 原生显示/GPU + 完整 USB-C/DP + 基带 + 音频（扬声器、听筒、WCD 麦克风/耳机）。
+ * 各部分逐个上机验证通过后用它做日常镜像。构建：FUXI_DTB=sm8550-xiaomi-fuxi-full scripts/fuxi-build-abl.sh <名字>
+ */
+
+#include "sm8550-xiaomi-fuxi-min.dts"
+#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
+#include "sm8550-xiaomi-fuxi-disp.dtsi"
+#include "sm8550-xiaomi-fuxi-usbc.dtsi"
+#include "sm8550-xiaomi-fuxi-modem.dtsi"
+#include "sm8550-xiaomi-fuxi-audio.dtsi"
+#include "sm8550-xiaomi-fuxi-audio2.dtsi"
+
+&mdss_dp0 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-min.dts b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-min.dts
new file mode 100644
index 000000000..fa0cbff12
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-min.dts
@@ -0,0 +1,892 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 13 (fuxi) 最小主线板级 DTS —— 只为“内核能启动 + USB 串口工作”
+ * 生成方式：从 sm8550-mtp.dts 裁剪（保留 PMIC 调压器与 USB 子树）
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "sm8550.dtsi"
+#include "pm8010.dtsi"
+#include "pm8550.dtsi"
+#include "pm8550b.dtsi"
+#define PMK8550VE_SID 5
+#include "pm8550ve.dtsi"
+#include "pm8550vs.dtsi"
+#include "pmk8550.dtsi"
+#include "pmr735d_a.dtsi"
+
+
+/ {
+	model = "Xiaomi 13 (fuxi) minimal";
+	compatible = "xiaomi,fuxi", "qcom,sm8550";
+	chassis-type = "handset";
+
+	/* ABL 按这两项从 boot 镜像里挑 DTB（值取自厂商 fuxi DTB）；没有它们 ABL 报 Load Error */
+	qcom,msm-id = <519 0x20000>, <536 0x20000>;
+	qcom,board-id = <0x10008 0>;
+
+	/* 音量上：PM8550 GPIO6，低有效（厂商 DTB gpio_keys/vol_up；与 sm8550-qrd 相同） */
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&volume_up_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * 电池/充电：ADSP 上的 battmgr 经 pmic_glink 暴露电量与充电状态。
+	 * 暂不接 USB-C connector（不编 UCSI），USB 保持固定 peripheral，免得 ADSP 切换角色断开 USB 网络。
+	 */
+	pmic-glink {
+		compatible = "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
+	aliases {
+		serial1 = &uart14;
+	};
+
+	/*
+	 * WiFi/蓝牙：WCN7850（Kiwi）。引脚与 sm8550-qrd 完全相同（厂商 DTB cnss/bt_kiwi：
+	 * wlan-en GPIO80、bt-en GPIO81、sw-ctrl GPIO82；PCIe0 perst GPIO94、wake GPIO96），
+	 * 供电对应关系同 QRD（只是 fuxi DTS 里的标签名不同）。
+	 */
+	wcn7850-pmu {
+		compatible = "qcom,wcn7850-pmu";
+
+		pinctrl-0 = <&wlan_en>, <&bt_default>, <&pmk8550_sleep_clk>;
+		pinctrl-names = "default";
+
+		wlan-enable-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
+
+		vdd-supply = <&vreg_s5g_0p8>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		vddaon-supply = <&vreg_s2g_0p8>;
+		vdddig-supply = <&vreg_s4e_0p9>;
+		vddrfa1p2-supply = <&vreg_s4g_1p3>;
+		vddrfa1p8-supply = <&vreg_s6g_1p8>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * 内核 cmdline 的唯一来源（ABL 启动时内核用内建 DTB，ABL 传的 cmdline 不生效）。
+		 * 末尾的空格是给旧的 UEFI 跳板（FuxiLinuxBoot 原地改写）留的余量。
+		 * 不要加 console=ttyGS0：/dev/console 会变成 USB 串口，主机没打开串口时缓冲区写满，
+		 * 往 /dev/console 写的进程（systemd 状态输出）全部阻塞——启动卡 6 分钟、关机永远卡住。
+		 */
+		bootargs = "loglevel=7 log_buf_len=2M panic=0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused arm-smmu.disable_bypass=0 cpuidle.off=1 fbcon=font:TER16x32 console=tty0 fuxi.fb=0xB8000000,1080,2400,1080,32 rdinit=/init g_cdc.idVendor=0x0525 g_cdc.idProduct=0xa4a7 g_cdc.dev_addr=02:f0:c5:13:00:02 g_cdc.host_addr=02:f0:c5:13:00:01                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ";
+
+		/*
+		 * bootloader（ABL/UEFI）留下的帧缓冲：1080x2400 XRGB8888，stride 4320。
+		 * 面板是 DSI command mode，MDSS autorefresh 持续从这里取帧；simpledrm 接管它
+		 * 当作标准显示设备（/dev/dri/card0 + fbcon）。内存在 reserved-memory 里保留。
+		 */
+		framebuffer0: framebuffer@b8000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xb8000000 0x0 0x9e3400>;
+			width = <1080>;
+			height = <2400>;
+			stride = <(1080 * 4)>;
+			format = "x8r8g8b8";
+		};
+	};
+
+	/*
+	 * 内存与固件保留区按"运行中系统"的 DTB（/sys/firmware/fdt，ABL 按本机 DDR 改写过，
+	 * 存档 work/device-info/fuxi-live.dts）：这台是 12 GB 版本。之前这里的布局来自不匹配的
+	 * 厂商 DTB：少了 4 GB，还把 0x8b9d00000 等几段非内存/受保护区声明成了内存。
+	 * 内建 DTB 忽略 ABL 的改写，所以这份布局只对这台机器有效。
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x00e00000>,
+		      <0x0 0x811d0000 0x0 0x56e30000>,
+		      <0x0 0xd8140000 0x0 0x00020000>,
+		      <0x0 0xe7cb0000 0x0 0x18350000>,
+		      <0x8 0x80000000 0x0 0x39d00000>,
+		      <0x8 0xb9f00000 0x0 0x01e00000>,
+		      <0x8 0xc0000000 0x0 0xc0000000>,
+		      <0x9 0x80000000 0x1 0x80000000>;
+	};
+
+	/*
+	 * 固件保留区以 sm8550.dtsi 为准（与本机固件布局一致），只补运行中 DTB 里多出来的几段，
+	 * 尺寸不同的在文件末尾按标签改。
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * 厂商 DTB 的 ramoops@0xa7000000：热重启后保留上一轮的内核日志（/sys/fs/pstore），
+		 * 用来查卡死/重启原因。4 MB = 2 MB console + 2 MB pmsg，与 Android 一致。
+		 */
+		ramoops@a7000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xa7000000 0x0 0x400000>;
+			console-size = <0x200000>;
+			pmsg-size = <0x200000>;
+		};
+
+		/* 厂商 DTB 的 cont_splash_region：bootloader 帧缓冲，不能给内核当普通内存用 */
+		cont_splash_mem: splash-region@b8000000 {
+			reg = <0x0 0xb8000000 0x0 0x2b00000>;
+			no-map;
+		};
+
+		xbl-ramdump-region@81200000 {
+			reg = <0x0 0x81200000 0x0 0x280000>;
+			no-map;
+		};
+
+		chipinfo-region@81cf4000 {
+			reg = <0x0 0x81cf4000 0x0 0x1000>;
+			no-map;
+		};
+
+		dump-display-region@a4a80000 {
+			reg = <0x0 0xa4a80000 0x0 0x800>;
+			no-map;
+		};
+
+		llcc-lpi-region@ff800000 {
+			reg = <0x0 0xff800000 0x0 0x600000>;
+			no-map;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8550-rpmh-regulators";
+		qcom,pmic-id = "b";
+
+		vdd-bob1-supply = <&vph_pwr>;
+		vdd-bob2-supply = <&vph_pwr>;
+		vdd-l1-l4-l10-supply = <&vreg_s6g_1p8>;
+		vdd-l2-l13-l14-supply = <&vreg_bob1>;
+		vdd-l3-supply = <&vreg_s4g_1p3>;
+		vdd-l5-l16-supply = <&vreg_bob1>;
+		vdd-l6-l7-supply = <&vreg_bob1>;
+		vdd-l8-l9-supply = <&vreg_bob1>;
+		vdd-l11-supply = <&vreg_s4g_1p3>;
+		vdd-l12-supply = <&vreg_s6g_1p8>;
+		vdd-l15-supply = <&vreg_s6g_1p8>;
+		vdd-l17-supply = <&vreg_bob2>;
+
+		vreg_bob1: bob1 {
+			regulator-name = "vreg_bob1";
+			regulator-min-microvolt = <3296000>;
+			regulator-max-microvolt = <3960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_bob2: bob2 {
+			regulator-name = "vreg_bob2";
+			regulator-min-microvolt = <2720000>;
+			regulator-max-microvolt = <3960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l1b_1p8: ldo1 {
+			regulator-name = "vreg_l1b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l2b_3p0: ldo2 {
+			regulator-name = "vreg_l2b_3p0";
+			regulator-min-microvolt = <3008000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l5b_3p1: ldo5 {
+			regulator-name = "vreg_l5b_3p1";
+			regulator-min-microvolt = <3104000>;
+			regulator-max-microvolt = <3104000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l6b_1p8: ldo6 {
+			regulator-name = "vreg_l6b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l7b_1p8: ldo7 {
+			regulator-name = "vreg_l7b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l8b_1p8: ldo8 {
+			regulator-name = "vreg_l8b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l9b_2p9: ldo9 {
+			regulator-name = "vreg_l9b_2p9";
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l11b_1p2: ldo11 {
+			regulator-name = "vreg_l11b_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1504000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l12b_1p8: ldo12 {
+			regulator-name = "vreg_l12b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l13b_3p0: ldo13 {
+			regulator-name = "vreg_l13b_3p0";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l14b_3p2: ldo14 {
+			regulator-name = "vreg_l14b_3p2";
+			regulator-min-microvolt = <3200000>;
+			regulator-max-microvolt = <3200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l15b_1p8: ldo15 {
+			regulator-name = "vreg_l15b_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l16b_2p8: ldo16 {
+			regulator-name = "vreg_l16b_2p8";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l17b_2p5: ldo17 {
+			regulator-name = "vreg_l17b_2p5";
+			regulator-min-microvolt = <2504000>;
+			regulator-max-microvolt = <2504000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pm8550vs-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		vdd-l3-supply = <&vreg_s4e_0p9>;
+
+		vreg_l3c_0p91: ldo3 {
+			regulator-name = "vreg_l3c_0p9";
+			regulator-min-microvolt = <880000>;
