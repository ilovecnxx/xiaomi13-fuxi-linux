+/* Halt all modem GSI channels after a modem crash.  The modem allocates
+ * these channels itself on IPA v5.5, and fails to initialize channel 0
+ * again after a restart if it was left running (seen on Xiaomi 13).
+ */
+void ipa_endpoint_modem_halt_all(struct ipa *ipa)
+{
+	u32 endpoint_id = 0;
+
+	while (endpoint_id < ipa->endpoint_count) {
+		struct ipa_endpoint *endpoint = &ipa->endpoint[endpoint_id++];
+
+		if (endpoint->ee_id != GSI_EE_MODEM)
+			continue;
+
+		gsi_modem_channel_halt(&ipa->gsi, endpoint->channel_id);
+	}
+}
